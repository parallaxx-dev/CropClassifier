# nginx:alpine renders /etc/nginx/templates/*.template into
# /etc/nginx/conf.d/ at container start, substituting only variables that
# exist in the environment -- so ${BACKEND_UPSTREAM} is filled in while
# nginx's own runtime variables ($host, $uri, ...) pass through untouched.
#
# react-router's BrowserRouter needs every unknown path (e.g. /draw,
# /live-validation on a hard refresh) served index.html instead of nginx's
# default 404 -- the client-side router takes it from there.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Must exceed the backend's own 25MB upload-aoi limit
    # (services/aoi_upload.py's MAX_UPLOAD_BYTES), or nginx rejects large
    # uploads with its own 413 before the backend's clearer error can fire.
    client_max_body_size 26m;

    # Same-origin reverse proxy to the backend. The frontend bundle calls
    # the API by relative path (/api/v1), so the browser never needs to know
    # where the backend lives -- no CORS, and no mixed-content blocking when
    # this page is served over HTTPS. BACKEND_UPSTREAM defaults to the
    # docker-compose service (backend:8000); override it to point elsewhere.
    location /api/ {
        proxy_pass http://${BACKEND_UPSTREAM}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # AOI fetch + 16-draw ensembled inference can take a while.
        proxy_read_timeout 300s;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
