# Optional host-level settings for docker-compose.yml. Copy to .env and edit;
# every value has a default, so this file can be skipped entirely.

# Host port the app is served on (nginx). 80 on a server; pick e.g. 8080
# locally if 80 is taken.
HTTP_PORT=80

# Where the gitignored parcel geometry data lives on this host. Defaults
# match the repo layout, so only set these if you keep the data elsewhere.
# PARCEL_GEOMS_DIR=./backend/training/eurocrops_output/multi_country/checkpoints
# LOCAL_PARCELS_DIR=./backend/local_parcels
