# Copy to backend/.env and fill in. Read by docker-compose.yml (env_file)
# and by app/config.py's load_dotenv() for local uvicorn runs.

# Copernicus Data Space Ecosystem -- Sentinel Hub OAuth client. Register one
# at https://shapps.dataspace.copernicus.eu/dashboard/ (User settings ->
# OAuth clients). Required: every live prediction fetches Sentinel-2 data
# through it.
CDSE_SH_CLIENT_ID=
CDSE_SH_CLIENT_SECRET=
